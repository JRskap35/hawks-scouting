# Supabase: click Connect at the top of your project and copy the session pooler connection string.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Sent in the User-Agent so site owners can reach you if the scraper ever bothers them.
SCRAPER_CONTACT=you@boisehawks.com

# Optional tuning
SCRAPER_DELAY_SEC=3
SCRAPER_CACHE_HOURS=12
